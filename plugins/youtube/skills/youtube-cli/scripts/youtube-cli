#!/usr/bin/env python3
"""youtube-cli — enumerate and inspect YouTube content via yt-dlp (library mode)."""

# ---------------------------------------------------------------------------
# Venv bootstrap — runs before any other import.
# If not already inside the managed venv, create it, install yt-dlp, re-exec.
# ---------------------------------------------------------------------------
import os
import sys

_VENV = "/tmp/youtube-cli-venv"
_MARKER = os.path.join(_VENV, ".youtube-cli-ready")

if not os.path.exists(_MARKER):
    import subprocess
    subprocess.check_call([sys.executable, "-m", "venv", _VENV])
    pip = os.path.join(_VENV, "bin", "pip")
    subprocess.check_call([pip, "install", "-q", "-U", "yt-dlp"])
    open(_MARKER, "w").close()

_venv_python = os.path.join(_VENV, "bin", "python3")
if os.path.abspath(sys.executable) != os.path.abspath(_venv_python):
    os.execv(_venv_python, [_venv_python] + sys.argv)

# ---------------------------------------------------------------------------
# Main script — runs inside the managed venv from here on.
# ---------------------------------------------------------------------------

import argparse
import datetime
import json
import urllib.parse
from pathlib import Path
from typing import IO, Any, Callable

import yt_dlp

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

CHANNEL_PATTERNS = ("/@", "/c/", "/user/", "/channel/")

# ---------------------------------------------------------------------------
# URL helpers
# ---------------------------------------------------------------------------


def resolve_video_url(id_or_url: str) -> str:
    """Return a full YouTube watch URL; treat bare strings as video IDs."""
    if "youtube.com" in id_or_url or "youtu.be" in id_or_url:
        return id_or_url
    return f"https://www.youtube.com/watch?v={id_or_url}"


def is_channel_url(url: str) -> bool:
    return any(pat in url for pat in CHANNEL_PATTERNS)


def is_playlist_url(url: str) -> bool:
    return "playlist?list=" in url


def build_channel_tab_url(url: str, tab: str) -> str:
    base = url.rstrip("/")
    mapping = {
        "videos": "/videos",
        "shorts": "/shorts",
        "streams": "/streams",
        "all": "",
        "playlists": "/playlists",
    }
    return base + mapping.get(tab, "")


def extract_video_id(url: str) -> str:
    """Extract the video ID from various YouTube URL shapes or bare IDs."""
    # Already a bare ID (no slashes, no dots typically)
    if "youtube.com" not in url and "youtu.be" not in url:
        return url

    parsed = urllib.parse.urlparse(url)

    # youtu.be/<id>
    if "youtu.be" in parsed.netloc:
        return parsed.path.lstrip("/").split("/")[0]

    # /shorts/<id>  or  /live/<id>
    parts = [p for p in parsed.path.split("/") if p]
    if len(parts) >= 2 and parts[0] in ("shorts", "live"):
        return parts[1]

    # watch?v=<id>
    qs = urllib.parse.parse_qs(parsed.query)
    if "v" in qs:
        return qs["v"][0]

    # Fall back: last path component
    return parts[-1] if parts else url


# ---------------------------------------------------------------------------
# Cache helpers
# ---------------------------------------------------------------------------


def cache_path(cache_dir: Path, kind: str, key: str) -> Path:
    ext = "vtt" if kind == "captions" else "json"
    p = cache_dir / kind / f"{key}.{ext}"
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def read_cache(path: Path) -> str | None:
    if path.exists() and path.stat().st_size > 0:
        return path.read_text(encoding="utf-8")
    return None


def write_cache(path: Path, data: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(data, encoding="utf-8")


# ---------------------------------------------------------------------------
# yt-dlp options factory
# ---------------------------------------------------------------------------


def make_ydl_opts(**overrides: Any) -> dict[str, Any]:
    base: dict[str, Any] = {
        "quiet": True,
        "no_warnings": True,
    }
    base.update(overrides)
    return base


# ---------------------------------------------------------------------------
# Entry projection
# ---------------------------------------------------------------------------


def project_entry(entry: dict[str, Any], channel_url: str) -> dict[str, Any]:
    vid_id = entry.get("id") or ""
    url = entry.get("url") or (
        f"https://www.youtube.com/watch?v={vid_id}" if vid_id else ""
    )
    return {
        "id": vid_id,
        "url": url,
        "title": entry.get("title"),
        "duration": entry.get("duration"),
        "view_count": entry.get("view_count"),
        "upload_date": entry.get("upload_date"),
        "timestamp": entry.get("timestamp"),
        "channel_url": channel_url,
        "live_status": entry.get("live_status"),
        "availability": entry.get("availability"),
        "thumbnails": entry.get("thumbnails"),
    }


# ---------------------------------------------------------------------------
# Date helpers
# ---------------------------------------------------------------------------


def _date_str_to_ts(date_str: str) -> int:
    """Convert YYYY-MM-DD string to Unix timestamp (UTC midnight)."""
    dt = datetime.datetime.strptime(date_str, "%Y-%m-%d").replace(
        tzinfo=datetime.timezone.utc
    )
    return int(dt.timestamp())


# ---------------------------------------------------------------------------
# Core extraction
# ---------------------------------------------------------------------------


def extract_flat(
    target_url: str,
    limit: int | None,
    date_after_ts: int | None,
    date_before_ts: int | None,
    min_views: int | None,
    injected_channel_url: str,
) -> list[dict[str, Any]]:
    opts = make_ydl_opts(
        extract_flat=True,
        extractor_args={"youtubetab": {"approximate_date": [""]}},
        ignoreerrors=True,
    )
    if limit:
        opts["playlistend"] = limit

    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(target_url, download=False)
    except Exception as exc:
        _handle_ydl_exception(exc)
        return []

    if info is None:
        print(f"WARNING: no info returned for {target_url}", file=sys.stderr)
        return []

    raw_entries: list[dict[str, Any]] = info.get("entries") or []
    results: list[dict[str, Any]] = []
    for e in raw_entries:
        if not e or not e.get("id"):
            continue
        proj = project_entry(e, injected_channel_url or target_url)

        # Client-side filters
        ts = proj.get("timestamp")
        if date_after_ts is not None and ts is not None and ts < date_after_ts:
            continue
        if date_before_ts is not None and ts is not None and ts > date_before_ts:
            continue
        if min_views is not None:
            vc = proj.get("view_count")
            if vc is None or vc < min_views:
                continue

        results.append(proj)

    return results


def extract_full(
    target_url: str,
    limit: int | None,
    date_after_ts: int | None,
    date_before_ts: int | None,
    min_views: int | None,
    min_duration: float | None,
    max_duration: float | None,
    injected_channel_url: str,
) -> list[dict[str, Any]]:
    opts = make_ydl_opts(
        extract_flat=False,
        ignoreerrors=True,
    )

    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(target_url, download=False)
    except Exception as exc:
        _handle_ydl_exception(exc)
        return []

    if info is None:
        print(f"WARNING: no info returned for {target_url}", file=sys.stderr)
        return []

    # Support both single-video and playlist results
    raw_entries: list[dict[str, Any]] = info.get("entries") or [info]

    results: list[dict[str, Any]] = []
    cap: int = limit or 500  # enforce cap

    for e in raw_entries:
        if not e or not e.get("id"):
            continue
        proj = project_entry(e, injected_channel_url or target_url)

        # Duration filter
        dur = proj.get("duration")
        if min_duration is not None and (dur is None or dur < min_duration):
            continue
        if max_duration is not None and (dur is None or dur > max_duration):
            continue

        # Date filter
        ts = proj.get("timestamp")
        if date_after_ts is not None and ts is not None and ts < date_after_ts:
            continue
        if date_before_ts is not None and ts is not None and ts > date_before_ts:
            continue

        # View count filter
        if min_views is not None:
            vc = proj.get("view_count")
            if vc is None or vc < min_views:
                continue

        results.append(proj)
        if len(results) >= cap:
            break

    return results


def fetch_metadata(video_url: str) -> dict[str, Any] | None:
    opts = make_ydl_opts(ignoreerrors=False)
    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info = ydl.extract_info(video_url, download=False)
    except Exception as exc:
        _handle_ydl_exception(exc)
        return None
    return info


def fetch_captions(video_url: str, video_id: str, lang: str, output_dir: Path) -> Path | None:
    """Two-pass: manual subs first, then auto-subs. Returns Path to VTT or None."""
    output_dir.mkdir(parents=True, exist_ok=True)
    expected = output_dir / f"{video_id}.{lang}.vtt"

    # Pass 1: manual subtitles
    opts1 = make_ydl_opts(
        skip_download=True,
        writesubtitles=True,
        writeautomaticsubs=False,
        subtitleslangs=[lang],
        subtitlesformat="vtt",
        outtmpl=str(output_dir / "%(id)s"),
        ignoreerrors=True,
    )
    try:
        with yt_dlp.YoutubeDL(opts1) as ydl:
            ydl.extract_info(video_url, download=True)
    except Exception as exc:
        _handle_ydl_exception(exc)

    if expected.exists() and expected.stat().st_size > 0:
        return expected

    # Pass 2: auto-generated subtitles
    opts2 = make_ydl_opts(
        skip_download=True,
        writesubtitles=False,
        writeautomaticsubs=True,
        subtitleslangs=[lang],
        subtitlesformat="vtt",
        outtmpl=str(output_dir / "%(id)s"),
        ignoreerrors=True,
    )
    try:
        with yt_dlp.YoutubeDL(opts2) as ydl:
            ydl.extract_info(video_url, download=True)
    except Exception as exc:
        _handle_ydl_exception(exc)

    if expected.exists() and expected.stat().st_size > 0:
        return expected

    return None


# ---------------------------------------------------------------------------
# Error handling helper
# ---------------------------------------------------------------------------


def _handle_ydl_exception(exc: Exception) -> None:
    msg = str(exc)
    if "429" in msg or "Too Many Requests" in msg:
        print(
            "WARNING: Rate limited by YouTube (HTTP 429). Wait before retrying.",
            file=sys.stderr,
        )
    else:
        print(f"WARNING: yt-dlp error: {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------


def _open_output(path_str: str | None) -> IO[str]:
    if path_str:
        p = Path(path_str)
        p.parent.mkdir(parents=True, exist_ok=True)
        return open(p, "w", encoding="utf-8")
    return sys.stdout


# ---------------------------------------------------------------------------
# Subcommand handlers
# ---------------------------------------------------------------------------


def cmd_list_videos(args: argparse.Namespace) -> None:
    url = args.url

    # Determine target URL and whether type flag is relevant
    if is_playlist_url(url):
        target_url = url
        injected_channel_url = ""
        if args.type and args.type != "videos":
            print(
                "WARNING: --type is ignored for playlist URLs.",
                file=sys.stderr,
            )
    elif is_channel_url(url):
        target_url = build_channel_tab_url(url, args.type or "videos")
        injected_channel_url = url
    else:
        print(
            f"ERROR: URL does not look like a channel or playlist URL: {url}",
            file=sys.stderr,
        )
        sys.exit(1)

    # Parse date bounds
    date_after_ts: int | None = _date_str_to_ts(args.after) if args.after else None
    date_before_ts: int | None = _date_str_to_ts(args.before) if args.before else None
    # For --before, include the whole day: advance to end-of-day
    if date_before_ts is not None:
        date_before_ts += 86399

    use_full: bool = (
        args.min_duration is not None
        or args.max_duration is not None
        or args.min_views is not None
    )
    if use_full:
        cap = args.limit or 500
        triggers = []
        if args.min_duration is not None or args.max_duration is not None:
            triggers.append("--min-duration/--max-duration")
        if args.min_views is not None:
            triggers.append("--min-views")
        print(
            f"WARNING: {', '.join(triggers)} triggers full extraction mode "
            f"(slower). Capped at {cap} results.",
            file=sys.stderr,
        )
        entries: list[dict[str, Any]] = extract_full(
            target_url,
            limit=cap,
            date_after_ts=date_after_ts,
            date_before_ts=date_before_ts,
            min_views=args.min_views,
            min_duration=args.min_duration,
            max_duration=args.max_duration,
            injected_channel_url=injected_channel_url,
        )
    else:
        entries = extract_flat(
            target_url,
            limit=args.limit,
            date_after_ts=date_after_ts,
            date_before_ts=date_before_ts,
            min_views=args.min_views,
            injected_channel_url=injected_channel_url,
        )

    out: IO[str] = _open_output(args.output)
    try:
        for entry in entries:
            out.write(json.dumps(entry) + "\n")
    finally:
        if out is not sys.stdout:
            out.close()


def cmd_list_playlists(args: argparse.Namespace) -> None:
    target_url = build_channel_tab_url(args.channel_url, "playlists")
    opts = make_ydl_opts(
        extract_flat=True,
        ignoreerrors=True,
    )
    if args.limit:
        opts["playlistend"] = args.limit

    try:
        with yt_dlp.YoutubeDL(opts) as ydl:
            info: dict[str, Any] | None = ydl.extract_info(target_url, download=False)
    except Exception as exc:
        _handle_ydl_exception(exc)
        sys.exit(1)

    if info is None:
        print(f"WARNING: no info returned for {target_url}", file=sys.stderr)
        sys.exit(1)

    out: IO[str] = _open_output(args.output)
    try:
        for e in info.get("entries") or []:
            if not e or not e.get("id"):
                continue
            row: dict[str, Any] = {
                "id": e.get("id"),
                "url": e.get("url") or f"https://www.youtube.com/playlist?list={e['id']}",
                "title": e.get("title"),
                "playlist_count": e.get("playlist_count"),
                "thumbnails": e.get("thumbnails"),
                "channel_url": args.channel_url,
            }
            out.write(json.dumps(row) + "\n")
    finally:
        if out is not sys.stdout:
            out.close()


def cmd_get_metadata(args: argparse.Namespace) -> None:
    cache_dir = Path("~/.cache/youtube-cli").expanduser()
    video_url = resolve_video_url(args.video)
    video_id = extract_video_id(video_url)

    # Cache read
    if not args.no_cache:
        cp = cache_path(cache_dir, "metadata", video_id)
        cached = read_cache(cp)
        if cached is not None:
            out = _open_output(args.output)
            try:
                out.write(cached.rstrip("\n") + "\n")
            finally:
                if out is not sys.stdout:
                    out.close()
            return

    info: dict[str, Any] | None = fetch_metadata(video_url)
    if info is None:
        print(f"ERROR: could not fetch metadata for {video_url}", file=sys.stderr)
        sys.exit(1)

    pretty: str = json.dumps(info, indent=2)

    # Cache write
    if not args.no_cache:
        cp = cache_path(cache_dir, "metadata", video_id)
        write_cache(cp, pretty)

    out: IO[str] = _open_output(args.output)
    try:
        out.write(pretty + "\n")
    finally:
        if out is not sys.stdout:
            out.close()


def cmd_get_captions(args: argparse.Namespace) -> None:
    cache_dir = Path("~/.cache/youtube-cli").expanduser()
    video_url = resolve_video_url(args.video)
    video_id = extract_video_id(video_url)
    lang = args.lang or "en"
    output_dir = Path(args.output_dir).expanduser()
    output_dir.mkdir(parents=True, exist_ok=True)

    dest = output_dir / f"{video_id}.{lang}.vtt"
    cache_key = f"{video_id}.{lang}"

    # Cache read
    if not args.no_cache:
        cp = cache_path(cache_dir, "captions", cache_key)
        cached = read_cache(cp)
        if cached is not None:
            dest.write_text(cached, encoding="utf-8")
            result = {"video_id": video_id, "path": str(dest), "lang": lang}
            print(json.dumps(result))
            return

    vtt_path: Path | None = fetch_captions(video_url, video_id, lang, output_dir)
    if vtt_path is None or not vtt_path.exists() or vtt_path.stat().st_size == 0:
        print(
            f"WARNING: no captions found for video {video_id} in language '{lang}'. "
            "If VTT files are empty, try: "
            "--extractor-args \"youtube:player_client=tv,mweb\"",
            file=sys.stderr,
        )
        sys.exit(1)

    # Cache write
    if not args.no_cache:
        cp = cache_path(cache_dir, "captions", cache_key)
        write_cache(cp, vtt_path.read_text(encoding="utf-8"))

    result = {"video_id": video_id, "path": str(vtt_path), "lang": lang}
    print(json.dumps(result))


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="youtube-cli",
        description="Enumerate and inspect YouTube content via yt-dlp.",
    )
    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Bypass cache for both reads and writes",
    )

    sub = parser.add_subparsers(dest="subcommand", required=True)

    # --- list-videos ---
    lv = sub.add_parser("list-videos", help="List videos from a channel or playlist")
    lv.add_argument("url", help="Channel or playlist URL")
    lv.add_argument("--after", metavar="YYYY-MM-DD", help="Only videos on/after this date")
    lv.add_argument("--before", metavar="YYYY-MM-DD", help="Only videos on/before this date")
    lv.add_argument("--limit", type=int, metavar="N", help="Max number of results")
    lv.add_argument(
        "--type",
        choices=["videos", "shorts", "streams", "all"],
        default="videos",
        help="Channel tab to enumerate (default: videos; ignored for playlist URLs)",
    )
    lv.add_argument("--min-views", type=int, metavar="N", help="Minimum view count")
    lv.add_argument(
        "--min-duration", type=float, metavar="SEC", help="Minimum duration in seconds"
    )
    lv.add_argument(
        "--max-duration", type=float, metavar="SEC", help="Maximum duration in seconds"
    )
    lv.add_argument("--output", metavar="FILE", help="Write JSONL output to this file")

    # --- list-playlists ---
    lp = sub.add_parser("list-playlists", help="List playlists for a channel")
    lp.add_argument("channel_url", help="Channel URL")
    lp.add_argument("--limit", type=int, metavar="N", help="Maximum number of playlists to return")
    lp.add_argument("--output", metavar="FILE", help="Write JSONL output to this file")

    # --- get-metadata ---
    gm = sub.add_parser("get-metadata", help="Fetch full metadata for a video")
    gm.add_argument("video", help="Video ID or URL")
    gm.add_argument(
        "--output", metavar="FILE", help="Write pretty-printed JSON to this file"
    )

    # --- get-captions ---
    gc = sub.add_parser("get-captions", help="Download captions as VTT")
    gc.add_argument("video", help="Video ID or URL")
    gc.add_argument("--lang", default="en", help="Language code (default: en)")
    gc.add_argument(
        "--output-dir", required=True, metavar="DIR", help="Directory to write VTT file"
    )

    return parser


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    dispatch: dict[str, Callable[[argparse.Namespace], None]] = {
        "list-videos": cmd_list_videos,
        "list-playlists": cmd_list_playlists,
        "get-metadata": cmd_get_metadata,
        "get-captions": cmd_get_captions,
    }
    handler: Callable[[argparse.Namespace], None] | None = dispatch.get(args.subcommand)
    if handler is None:
        parser.print_help()
        sys.exit(1)
    handler(args)


if __name__ == "__main__":
    main()
